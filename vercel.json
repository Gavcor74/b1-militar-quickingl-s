{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/b1",
      "destination": "/index.html"
    },
    {
      "source": "/b2",
      "destination": "/b2.html"
    },
    {
      "source": "/b1-clasico",
      "destination": "/b1-clasico.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
